@model IEnumerable<QuanLyCuaHangTienLoi.Models.DonHang>

@{
    ViewData["Title"] = "Danh sách đơn hàng";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">📦 Danh sách đơn hàng</h1>
        <a asp-area="Admin" asp-controller="BangDieuKhien" asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách đơn hàng</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Mã đơn hàng</th>
                            <th>Mã hóa đơn</th>
                            <th>Nhân viên</th>
                            <th>Ngày tạo</th>
                            <th>Tổng tiền trước giảm</th>
                            <th>Giảm giá</th>
                            <th>Tổng tiền sau giảm</th>
                            <th>Phương thức thanh toán</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>#@item.MaDonHang</td>
                                    <td>@(item.MaHoaDon ?? "N/A")</td>
                                    <td>@(item.FkMaNvNavigation?.HoTen ?? "N/A")</td>
                                    <td>@(item.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</td>
                                    <td>@item.TongTienTruocGiam.ToString("N0") VNĐ</td>
                                    <td>@item.TongTienGiamGia.ToString("N0") VNĐ</td>
                                    <td><strong class="text-primary">@item.TongTienSauGiam.ToString("N0") VNĐ</strong></td>
                                    <td>
                                        <span class="badge badge-info">@(item.PhuongThucThanhToan ?? "N/A")</span>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.MaDonHang" class="btn btn-sm btn-info mb-1" title="Chi tiết">
                                            <i class="fas fa-info-circle"></i> Chi tiết
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.MaDonHang" class="btn btn-sm btn-warning mb-1" title="Sửa">
                                            <i class="fas fa-edit"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaDonHang" class="btn btn-sm btn-danger mb-1" title="Xóa">
                                            <i class="fas fa-trash"></i> Xóa
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">
                                    <i class="fas fa-inbox fa-3x mb-3"></i>
                                    <p>Chưa có đơn hàng nào</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
