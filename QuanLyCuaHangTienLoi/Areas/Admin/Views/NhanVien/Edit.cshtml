@model QuanLyCuaHangTienLoi.Models.NhanVien
@{
    ViewData["Title"] = "Sửa thông tin nhân viên";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">✏️ Sửa thông tin nhân viên</h1>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Thông tin nhân viên</h6>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="MaNv" />
                        <input type="hidden" asp-for="MatKhauHash" />
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="MaNv" class="control-label">Mã nhân viên</label>
                                    <input asp-for="MaNv" class="form-control" readonly />
                                    <span asp-validation-for="MaNv" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="TenNv" class="control-label">Tên nhân viên <span class="text-danger">*</span></label>
                                    <input asp-for="TenNv" class="form-control" />
                                    <span asp-validation-for="TenNv" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="IdChucvu" class="control-label">Chức vụ <span class="text-danger">*</span></label>
                                    <select asp-for="IdChucvu" class="form-control" asp-items="ViewBag.IdChucvu">
                                        <option value="">-- Chọn chức vụ --</option>
                                    </select>
                                    <span asp-validation-for="IdChucvu" class="text-danger"></span>
                                    @if (ViewBag.IdChucvu == null)
                                    {
                                        <span class="text-danger">Không có dữ liệu chức vụ. Vui lòng thêm chức vụ trước.</span>
                                    }
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Luongcoban" class="control-label">Lương cơ bản</label>
                                    <input asp-for="Luongcoban" class="form-control" type="number" step="0.01" />
                                    <span asp-validation-for="Luongcoban" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Phucap" class="control-label">Phụ cấp</label>
                                    <input asp-for="Phucap" class="form-control" type="number" step="0.01" />
                                    <span asp-validation-for="Phucap" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Ngayvaolam" class="control-label">Ngày vào làm</label>
                                    <input name="Ngayvaolam" value="@(Model.Ngayvaolam?.ToString("yyyy-MM-dd") ?? "")" class="form-control" type="date" />
                                    <span asp-validation-for="Ngayvaolam" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Ngaynghiviec" class="control-label">Ngày nghỉ việc</label>
                                    <input name="Ngaynghiviec" value="@(Model.Ngaynghiviec?.ToString("yyyy-MM-dd") ?? "")" class="form-control" type="date" />
                                    <span asp-validation-for="Ngaynghiviec" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Lưu thay đổi
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.MaNv" class="btn btn-info">
                                <i class="fas fa-eye"></i> Xem chi tiết
                            </a>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-info">💡 Lưu ý</h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li><i class="fas fa-info-circle text-info"></i> Mật khẩu không thể thay đổi ở đây</li>
                        <li><i class="fas fa-info-circle text-info"></i> Để reset mật khẩu, sử dụng chức năng "Reset mật khẩu"</li>
                        <li><i class="fas fa-info-circle text-info"></i> Các trường có dấu <span class="text-danger">*</span> là bắt buộc</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

