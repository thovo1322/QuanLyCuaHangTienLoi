@model QuanLyCuaHangTienLoi.Models.NhanVien
@{
    ViewData["Title"] = "Reset mật khẩu";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">🔑 Reset mật khẩu nhân viên</h1>
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4 border-warning">
                <div class="card-header py-3 bg-warning text-dark">
                    <h6 class="m-0 font-weight-bold">Xác nhận reset mật khẩu</h6>
                </div>
                <div class="card-body">
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-info-circle"></i> Mật khẩu sẽ được reset về mặc định: <strong>123456</strong>
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Mã nhân viên:</dt>
                        <dd class="col-sm-8">@Model.MaNv</dd>

                        <dt class="col-sm-4">Tên nhân viên:</dt>
                        <dd class="col-sm-8">@Model.TenNv</dd>

                        <dt class="col-sm-4">Chức vụ:</dt>
                        <dd class="col-sm-8">
                            <span class="badge badge-info">@Model.IdChucvuNavigation?.TenVaiTro</span>
                        </dd>
                    </dl>

                    <form asp-action="ResetPassword" method="post">
                        <input type="hidden" asp-for="MaNv" />
                        <div class="form-group">
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-key"></i> Xác nhận reset mật khẩu
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.MaNv" class="btn btn-info">
                                <i class="fas fa-eye"></i> Xem chi tiết
                            </a>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-info">💡 Lưu ý</h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li><i class="fas fa-check text-success"></i> Mật khẩu mới: <strong>123456</strong></li>
                        <li><i class="fas fa-info-circle text-info"></i> Nhân viên nên đổi mật khẩu ngay sau khi đăng nhập</li>
                        <li><i class="fas fa-info-circle text-info"></i> Mật khẩu sẽ được hash trước khi lưu vào database</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

