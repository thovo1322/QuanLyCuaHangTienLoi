@model IEnumerable<QuanLyCuaHangTienLoi.Models.NhanVien>
@{
    ViewData["Title"] = "Quản lý nhân viên";
    
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">👥 Quản lý nhân viên</h1>
        <div>
            <a asp-area="Admin" asp-controller="BangDieuKhien" asp-action="Index" class="btn btn-secondary btn-sm me-2">
                <i class="fas fa-arrow-left"></i> Quay lại
            </a>
            <a asp-action="Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus fa-sm text-white-50"></i> Thêm nhân viên
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Danh sách nhân viên</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Mã NV</th>
                            <th>Tên nhân viên</th>
                            <th>Chức vụ</th>
                            <th>Lương cơ bản</th>
                            <th>Phụ cấp</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.MaNv</td>
                                <td>@item.TenNv</td>
                                <td>
                                    <span class style="color:black !important;">@item.IdChucvuNavigation?.TenVaiTro</span>
                                    @* <span class="badge badge-info"> *@
                                </td>
                                <td>@item.Luongcoban?.ToString("N0") VNĐ</td>
                                <td>@item.Phucap?.ToString("N0") VNĐ</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@item.MaNv" class="btn btn-info btn-sm">
                                            <i class="fas fa-eye"></i>Chi tiết
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.MaNv" class="btn btn-warning btn-sm">
                                            <i class="fas fa-edit"></i>Sửa
                                        </a>
                                        <a asp-action="ResetPassword" asp-route-id="@item.MaNv" class="btn btn-secondary btn-sm">
                                            <i class="fas fa-key"></i> Reset
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.MaNv" class="btn btn-danger btn-sm">
                                            <i class="fas fa-trash"></i> Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12">
