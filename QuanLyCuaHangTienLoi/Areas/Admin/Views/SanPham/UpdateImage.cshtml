@model QuanLyCuaHangTienLoi.Models.SanPham

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Cập nhật hình ảnh sản phẩm</h1>

        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Thông tin sản phẩm: @Model.Ten</h6>
                </div>
                <div class="card-body">
                    <form asp-action="UpdateImage" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="MaSanPham" />
                        
                        <div class="form-horizontal">
                            <h4>Cập nhật hình ảnh</h4>
                            <div class="form-group mb-3">
                                <label class="control-label" for="files">Chọn hình ảnh</label>
                                <input type="file" name="files" class="form-control" accept="image/*" multiple />
                                @* <small class="form-text text-muted">Có thể chọn nhiều ảnh cùng lúc</small> *@
                            </div>
                            
                            @if (TempData["Success"] != null)
                            {
                                <div class="alert alert-success">@TempData["Success"]</div>
                            }
                            @if (TempData["Error"] != null)
                            {
                                <div class="alert alert-danger">@TempData["Error"]</div>
                            }
                            
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary">Cập nhật ảnh</button>
                                <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

